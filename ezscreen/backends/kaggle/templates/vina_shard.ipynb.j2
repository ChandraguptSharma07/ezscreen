  {
   "cell_type": "code",
   "id": "cell-05",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json, pathlib, shutil, subprocess, sys\n",
    "\n",
    "RECEPTOR_PH = << ph >>\n",
    "_working = pathlib.Path('/kaggle/working')\n",
    "_receptor_error = _working / 'error.json'\n",
    "\n",
    "def _write_receptor_error(message, **extra):\n",
    "    payload = {'cell': 'receptor_prep', 'variant': RECEPTOR_VARIANT, 'message': message}\n",
    "    payload.update(extra)\n",
    "    _receptor_error.write_text(json.dumps(payload))\n",
    "\n",
    "def _find_input_file(filename):\n",
    "    _hits = list(pathlib.Path('/kaggle/input').rglob(filename))\n",
    "    if not _hits:\n",
    "        _write_receptor_error(f'{filename} not found under /kaggle/input')\n",
    "        raise FileNotFoundError(filename)\n",
    "    return _hits[0]\n",
    "\n",
    "def _infer_element(atom_name, resname=''):\n",
    "    _name = atom_name.strip().lstrip('0123456789')\n",
    "    if not _name:\n",
    "        return ''\n",
    "    if _name.upper() == 'CA' and resname.strip().upper() != 'CA':\n",
    "        return 'C'\n",
    "    _two = _name[:2].upper()\n",
    "    if _two in {'FE', 'ZN', 'MG', 'MN', 'CA', 'NA', 'CL', 'BR', 'CU', 'CO', 'NI'}:\n",
    "        return _two\n",
    "    return _name[0].upper()\n",
    "\n",
    "def _pqr_atom_to_pdb_line(line, serial):\n",
    "    parts = line.split()\n",
    "    if len(parts) < 10 or parts[0] not in {'ATOM', 'HETATM'}:\n",
    "        return None\n",
    "    record = parts[0]\n",
    "    atom = parts[2]\n",
    "    resname = parts[3]\n",
    "    chain = ''\n",
    "    idx = 4\n",
    "    if idx < len(parts) and len(parts[idx]) == 1 and not parts[idx].lstrip('-').isdigit():\n",
    "        chain = parts[idx]\n",
    "        idx += 1\n",
    "    try:\n",
    "        resseq = int(float(parts[idx]))\n",
    "        x = float(parts[idx + 1])\n",
    "        y = float(parts[idx + 2])\n",
    "        z = float(parts[idx + 3])\n",
    "    except (IndexError, ValueError):\n",
    "        return None\n",
    "    element = _infer_element(atom, resname)\n",
    "    return (\n",
    "        f'{record:<6}{serial:>5} {atom:<4} {resname:>3} {chain:1}{resseq:>4}    '\n",
    "        f'{x:>8.3f}{y:>8.3f}{z:>8.3f}{1.00:>6.2f}{0.00:>6.2f}          {element:>2}'\n",
    "    )\n",
    "\n",
    "def _pqr_to_pdb(pqr_path, pdb_path):\n",
    "    lines = []\n",
    "    serial = 1\n",
    "    for line in pqr_path.read_text(errors='ignore').splitlines():\n",
    "        if line.startswith(('ATOM', 'HETATM')):\n",
    "            pdb_line = _pqr_atom_to_pdb_line(line, serial)\n",
    "            if pdb_line is None:\n",
    "                continue\n",
    "            serial += 1\n",
    "            lines.append(pdb_line)\n",
    "        elif line.startswith(('TER', 'END')):\n",
    "            lines.append(line)\n",
    "    if not any(ln.startswith('ATOM') for ln in lines):\n",
    "        raise RuntimeError('PDB2PQR produced no protein atoms')\n",
    "    if not lines or not lines[-1].startswith('END'):\n",
    "        lines.append('END')\n",
    "    pdb_path.write_text('\\n'.join(lines) + '\\n')\n",
    "\n",
    "_TITRATABLE_RESIDUES = {'ASH', 'ASP', 'CYM', 'CYS', 'GLH', 'GLU', 'HID', 'HIE', 'HIP', 'HIS', 'LYN', 'LYS', 'TYM', 'TYR'}\n",
    "\n",
    "def _pqr_residue_assignments(pqr_path):\n",
    "    grouped = {}\n",
    "    fallback_by_resseq = {}\n",
    "    for line in pqr_path.read_text(errors='ignore').splitlines():\n",
    "        if not line.startswith(('ATOM', 'HETATM')):\n",
    "            continue\n",
    "        pdb_line = _pqr_atom_to_pdb_line(line, 1)\n",
    "        if pdb_line is None:\n",
    "            continue\n",
    "        resname = pdb_line[17:20].strip()\n",
    "        if resname not in _TITRATABLE_RESIDUES:\n",
    "            continue\n",
    "        try:\n",
    "            resseq = int(pdb_line[22:26])\n",
    "        except ValueError:\n",
    "            continue\n",
    "        chain = pdb_line[21:22].strip()\n",
    "        icode = pdb_line[26:27].strip()\n",
    "        entry = grouped.setdefault((chain, resseq, icode), {'resname': resname, 'atom_names': set()})\n",
    "        entry['atom_names'].add(pdb_line[12:16].strip().upper())\n",
    "    assignments = {}\n",
    "    for key, entry in grouped.items():\n",
    "        resname = entry['resname']\n",
    "        atom_names = entry['atom_names']\n",
    "        state = resname\n",
    "        if resname == 'HIS':\n",
    "            has_hd1 = 'HD1' in atom_names\n",
    "            has_he2 = 'HE2' in atom_names\n",
    "            if has_hd1 and has_he2:\n",
    "                state = 'HIP'\n",
    "            elif has_hd1:\n",
    "                state = 'HID'\n",
    "            elif has_he2:\n",
    "                state = 'HIE'\n",
    "        assignments[key] = state\n",
    "        fallback_by_resseq.setdefault(key[1], state)\n",
    "    return assignments, fallback_by_resseq\n",
    "\n",
    "def _ensure_element_columns(lines):\n",
    "    fixed = []\n",
    "    for line in lines:\n",
    "        if line.startswith(('ATOM  ', 'HETATM')) and (len(line) < 78 or not line[76:78].strip()):\n",
    "            atom_name = line[12:16].strip()\n",
    "            resname = line[17:20].strip()\n",
    "            element = _infer_element(atom_name, resname)\n",
    "            suffix = line[78:] if len(line) > 78 else ''\n",
    "            line = f'{line[:76]:<76}{element:>2}{suffix}'\n",
    "        fixed.append(line)\n",
    "    return fixed\n",
    "\n",
    "def _apply_pqr_residue_names_to_source(source_pdb, pqr_path, pdb_path):\n",
    "    assignments, fallback_by_resseq = _pqr_residue_assignments(pqr_path)\n",
    "    lines = []\n",
    "    applied = {}\n",
    "    has_chains = any(key[0] for key in assignments)\n",
    "    for line in source_pdb.read_text(errors='ignore').splitlines():\n",
    "        if line.startswith(('ATOM  ', 'HETATM')):\n",
    "            try:\n",
    "                chain = line[21:22].strip()\n",
    "                resseq = int(line[22:26])\n",
    "                icode = line[26:27].strip()\n",
    "            except (IndexError, ValueError):\n",
    "                lines.append(line)\n",
    "                continue\n",
    "            new_resname = assignments.get((chain, resseq, icode))\n",
    "            if new_resname is None and not has_chains:\n",
    "                new_resname = fallback_by_resseq.get(resseq)\n",
    "            if new_resname:\n",
    "                line = line[:17] + f'{new_resname:>3}' + line[20:]\n",
    "                applied[(chain, resseq, icode)] = new_resname\n",
    "        lines.append(line)\n",
    "    if not any(ln.startswith('ATOM') for ln in lines):\n",
    "        _pqr_to_pdb(pqr_path, pdb_path)\n",
    "        return len(assignments)\n",
    "    lines = _ensure_element_columns(lines)\n",
    "    pdb_path.write_text('\\n'.join(lines) + '\\n')\n",
    "    return len(applied)\n",
    "\n",
    "def _clean_for_meeko(src, dst):\n",
    "    skip_records = {'CONECT', 'LINK  ', 'SSBOND'}\n",
    "    lines = []\n",
    "    for line in src.read_text(errors='ignore').splitlines():\n",
    "        if line[:6] in skip_records:\n",
    "            continue\n",
    "        if line.startswith(('ATOM  ', 'HETATM')):\n",
    "            element = line[76:78].strip() if len(line) >= 78 else ''\n",
    "            atom_name = line[12:16].strip()\n",
    "            if element == 'H' or (not element and atom_name.startswith('H')):\n",
    "                continue\n",
    "            if atom_name in {'OXT', 'OT1', 'OT2'}:\n",
    "                continue\n",
    "        lines.append(line)\n",
    "    if not any(ln.startswith(('ATOM  ', 'HETATM')) for ln in lines):\n",
    "        raise RuntimeError('clean receptor contains no atoms')\n",
    "    dst.write_text('\\n'.join(lines) + '\\n')\n",
    "\n",
    "def _which(*names):\n",
    "    for name in names:\n",
    "        exe = shutil.which(name)\n",
    "        if exe:\n",
    "            return exe\n",
    "    return None\n",
    "\n",
    "def _variant_slug(name):\n",
    "    return ''.join(ch if ch.isalnum() or ch in {'-', '_'} else '_' for ch in str(name)) or 'variant'\n",
    "\n",
    "def _prepare_receptor_variant(spec):\n",
    "    global RECEPTOR_VARIANT, RECEPTOR_FILENAME, RECEPTOR_PATH\n",
    "    RECEPTOR_VARIANT = spec.get('name', 'default')\n",
    "    RECEPTOR_FILENAME = spec.get('filename', 'receptor.pdbqt')\n",
    "    RECEPTOR_PATH = _find_input_file(RECEPTOR_FILENAME)\n",
    "    if RECEPTOR_VARIANT == 'default' or not spec.get('prepare_on_kaggle'):\n",
    "        return RECEPTOR_PATH\n",
    "    if RECEPTOR_VARIANT != 'propka_ph':\n",
    "        _write_receptor_error(f'unsupported receptor variant: {RECEPTOR_VARIANT}')\n",
    "        raise RuntimeError(f'Unsupported receptor variant: {RECEPTOR_VARIANT}')\n",
    "    source_pdb = _find_input_file(RECEPTOR_PDB_FILENAME)\n",
    "    _slug = _variant_slug(RECEPTOR_VARIANT)\n",
    "    pqr_path = _working / f'receptor_{_slug}.pqr'\n",
    "    propka_pdb = _working / f'receptor_{_slug}.pdb'\n",
    "    clean_pdb = _working / f'receptor_{_slug}_clean.pdb'\n",
    "    out_pdbqt = _working / f'receptor_{_slug}.pdbqt'\n",
