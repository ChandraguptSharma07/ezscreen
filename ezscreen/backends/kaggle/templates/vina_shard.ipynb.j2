    "import json, pathlib\n",
    "\n",
    "# Kaggle mounts datasets under /kaggle/input/<slug>/ but sometimes adds\n",
    "# a nested subdirectory with the same name. Discover files dynamically.\n",
    "_input_root = pathlib.Path('/kaggle/input')\n",
    "\n",
    "RECEPTOR_VARIANT_SPECS = << receptor_variant_specs_py >>\n",
    "RECEPTOR_FILENAME = RECEPTOR_VARIANT_SPECS[0].get('filename', 'receptor.pdbqt')\n",
    "RECEPTOR_VARIANT = RECEPTOR_VARIANT_SPECS[0].get('name', 'default')\n",
    "RECEPTOR_PDB_FILENAME = '<< receptor_pdb_filename >>'\n",
    "_receptor_candidates = list(_input_root.rglob(RECEPTOR_FILENAME))\n",
    "_input_preview = [str(p) for p in list(_input_root.rglob(\"*\"))[:20]]\n",
    "assert _receptor_candidates, (\n",
    "    f'{RECEPTOR_FILENAME} not found anywhere under {_input_root}\\n'\n",
    "    f'Contents: {_input_preview}'\n",
    ")\n",
    "RECEPTOR_PATH = _receptor_candidates[0]\n",
    "\n",
    "# This notebook is responsible for the following shard files:\n",
    "SHARD_FILENAMES = [<% for fn in shard_filenames %>'<< fn >>'<% if not loop.last %>, <% endif %><% endfor %>]\n",
    "LIGAND_PATHS = []\n",
    "_missing_shards = []\n",
    "for _fn in SHARD_FILENAMES:\n",
    "    _candidates = list(_input_root.rglob(_fn))\n",
    "    if not _candidates:\n",
    "        _missing_shards.append(_fn)\n",
    "        continue\n",
    "    LIGAND_PATHS.append(_candidates[0])\n",
    "assert LIGAND_PATHS, (\n",
    "    f'None of the requested shard files were found under {_input_root}\\n'\n",
    "    f'Requested: {SHARD_FILENAMES}\\n'\n",
    "    f'Contents: {_input_preview}'\n",
    ")\n",
    "if _missing_shards:\n",
    "    print(f'Ignoring shard filenames not present in this dataset: {_missing_shards}')\n",
    "\n",
    "print(f'Receptor : {RECEPTOR_PATH}  variant={RECEPTOR_VARIANT}')\n",
    "for _lp in LIGAND_PATHS:\n",
    "    print(f'Shard    : {_lp}  ({_lp.stat().st_size // 1024} KB)')\n",
    "print(f'Cell 4 done: {len(LIGAND_PATHS)} shard(s) loaded')\n"
   ]
