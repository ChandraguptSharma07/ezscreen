    "import subprocess, sys\n",
    "\n",
    "def _run(cmd):\n",
    "    r = subprocess.run(cmd, shell=True, capture_output=True, text=True)\n",
    "    if r.returncode != 0:\n",
    "        import json, pathlib\n",
    "        pathlib.Path('/kaggle/working/error.json').write_text(\n",
    "            json.dumps({'cell': 'install', 'cmd': cmd, 'stderr': r.stderr[-2000:]})\n",
    "        )\n",
    "        raise RuntimeError(f'Install failed: {cmd}\\n{r.stderr[-500:]}')\n",
    "import shutil\n",
    "def _require_tools(*names):\n",
    "    missing = [name for name in names if shutil.which(name) is None]\n",
    "    if missing:\n",
    "        raise RuntimeError(f'Required system tools are unavailable on Kaggle: {missing}')\n",
    "def _note_optional_tool(name, reason):\n",
    "    if shutil.which(name) is None:\n",
    "        print(f'Optional tool unavailable: {name} ({reason})')\n",
    "def _apt_install(*packages):\n",
    "    if shutil.which('apt-get') is None:\n",
    "        raise RuntimeError(f'apt-get is unavailable; cannot install required packages: {packages}')\n",
    "    joined = ' '.join(packages)\n",
    "    _run('DEBIAN_FRONTEND=noninteractive apt-get update -y')\n",
    "    _run(f'DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends {joined}')\n",
    "\n",
    "<% if engine == 'gnina' %>\n",
    "# GNINA -- install the prebuilt static binary (no reliable pip/conda path on the\n",
    "# Kaggle image; CNN weights download at first run). Rule 7 risk logged.\n",
    "# Pinned to v1.3.3's CUDA-12.8 static build (~2 GB) to match Kaggle's toolkit;\n",
    "# release asset names are not stable, so /latest/download/gnina 404s.\n",
    "import os as _os, stat as _stat, urllib.request as _ur\n",
    "_GNINA = '/usr/local/bin/gnina'\n",
    "try:\n",
    "    _ur.urlretrieve('https://github.com/gnina/gnina/releases/download/v1.3.3/gnina.cuda12.8.static', _GNINA)\n",
    "    _os.chmod(_GNINA, _os.stat(_GNINA).st_mode | _stat.S_IEXEC)\n",
    "    _v = subprocess.run([_GNINA, '--version'], capture_output=True, text=True)\n",
    "    print('gnina:', (_v.stdout or _v.stderr).strip()[:120])\n",
    "    if _v.returncode != 0:\n",
    "        raise RuntimeError(f'gnina --version exit {_v.returncode}: {_v.stderr[-300:]}')\n",
    "except Exception as _e:\n",
    "    import json as _json, pathlib as _pl\n",
    "    _pl.Path('/kaggle/working/error.json').write_text(_json.dumps({'cell': 'install', 'message': f'gnina install failed: {_e}'}))\n",
    "    raise\n",
    "<% elif engine == 'unidock-pro' %>\n",
    "# UniDock-Pro -- build from source\n",
    "_require_tools('cmake', 'git')\n",
    "_apt_install('libboost-all-dev')\n",
    "_run('rm -rf /tmp/unidock && git clone --depth 1 https://github.com/dptech-corp/Uni-Dock /tmp/unidock')\n",
    "_run('cmake -S /tmp/unidock/unidock -B /tmp/unidock/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES=\"60;75\" && cmake --build /tmp/unidock/build -j$(nproc)')\n",
    "_run('ln -sf /tmp/unidock/build/unidock /usr/local/bin/unidock')\n",
    "<% else %>\n",
    "# UniDock -- prefer the known-good Kaggle source-build path whenever nvcc is\n",
    "# present, otherwise fall back to a packaged or published binary.\n",
    "_run('pip install unidock-tools -q')\n",
    "\n",
    "import pathlib as _pl, os as _os, shutil as _sh, stat as _stat, urllib.request as _ur\n",
    "_BIN = '/tmp/unidock/build/unidock'\n",
    "_FALLBACK_BIN = '/tmp/unidock-prebuilt/unidock'\n",
    "_FALLBACK_URL = 'https://github.com/dptech-corp/Uni-Dock/releases/download/1.1.0/unidock-1.1.0-cuda120-linux-x86_64'\n",
    "_PACKAGED_BIN = _sh.which('unidock')\n",
    "\n",
    "_nvcc_bin = _sh.which('nvcc')\n",
    "\n",
    "if _pl.Path(_BIN).exists() and _os.path.getsize(_BIN) > 500_000:\n",
    "    print(f'Reusing cached UniDock binary: {_BIN}')\n",
    "elif _nvcc_bin:\n",
    "    print(f'Building UniDock from source with {_nvcc_bin}...')\n",
    "    _require_tools('cmake', 'git')\n",
    "    _apt_install('libboost-all-dev')\n",
    "    subprocess.run('nvcc --version', shell=True, check=False)\n",
    "    _run('rm -rf /tmp/unidock && git clone --depth 1 https://github.com/dptech-corp/Uni-Dock /tmp/unidock')\n",
    "    _run('cmake -S /tmp/unidock/unidock -B /tmp/unidock/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES=\"60;75\"')\n",
    "    _run('cmake --build /tmp/unidock/build -j$(nproc)')\n",
    "    print('UniDock source build complete')\n",
    "elif _PACKAGED_BIN:\n",
    "    print(f'Using packaged UniDock binary: {_PACKAGED_BIN}')\n",
    "else:\n",
    "    _fallback_path = _pl.Path(_FALLBACK_BIN)\n",
    "    _fallback_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    try:\n",
    "        print(f'Downloading UniDock fallback binary from {_FALLBACK_URL}...')\n",
    "        _ur.urlretrieve(_FALLBACK_URL, _FALLBACK_BIN)\n",
    "        _os.chmod(_FALLBACK_BIN, _os.stat(_FALLBACK_BIN).st_mode | _stat.S_IEXEC)\n",
    "    except Exception as _fallback_exc:\n",
    "        raise RuntimeError(f'unidock binary missing after unidock-tools install and fallback download failed: {_fallback_exc}')\n",
    "\n",
    "if _pl.Path(_BIN).exists() and _os.path.getsize(_BIN) > 500_000:\n",
    "    _run(f'ln -sf {_BIN} /usr/local/bin/unidock')\n",
    "elif (not _PACKAGED_BIN) and _pl.Path(_FALLBACK_BIN).exists() and _os.path.getsize(_FALLBACK_BIN) > 500_000:\n",
    "    _run(f'ln -sf {_FALLBACK_BIN} /usr/local/bin/unidock')\n",
    "assert _sh.which('unidock'), 'unidock not in PATH after symlink'\n",
    "_help_r = subprocess.run(['unidock', '--help'], capture_output=True, text=True)\n",
    "print(f'unidock binary: {_sh.which(\"unidock\")}')\n",
    "print('unidock --help exit:', _help_r.returncode)\n",
    "print((_help_r.stdout or _help_r.stderr)[:5000])\n",
    "<% endif %>\n",
    "\n",
    "_note_optional_tool('obabel', 'used only for fallback ligand-format conversion')\n",
    "# rdkit must be present for prep (cell 6) and SDF conversion (cell 8). The\n",
    "# regular UniDock path got it transitively via unidock-tools; the UniDock-Pro\n",
    "# source build does not, so install it explicitly when missing.\n",
    "try:\n",
    "    import rdkit  # noqa: F401\n",
    "except ImportError:\n",
    "    _run('pip install rdkit -q')\n",
    "_run('pip install meeko gemmi prody -q')\n",
    "<% if receptor_prepare_on_kaggle %>\n",
    "_run('pip install pdb2pqr propka -q')\n",
    "<% endif %>\n",
    "<% if enumerate_enabled and prep_on_kaggle %>\n",
    "_run('pip install gypsum-dl -q')\n",
    "<% endif %>\n",
    "\n",
    "print('Cell 2 done: dependencies installed')\n"
   ]
