    "        _excl.add((min(_i, _j), max(_i, _j)))\n",
    "    for _atom in _mol_h.GetAtoms():\n",
    "        _nbrs = [_nb.GetIdx() for _nb in _atom.GetNeighbors()]\n",
    "        for _a in range(len(_nbrs)):\n",
    "            for _c in range(_a + 1, len(_nbrs)):\n",
    "                _excl.add((min(_nbrs[_a], _nbrs[_c]), max(_nbrs[_a], _nbrs[_c])))\n",
